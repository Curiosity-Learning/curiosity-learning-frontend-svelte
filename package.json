{
	"name": "curiosity-learning-flutter-to-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:backend": "convex dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"lint:ci": "eslint .",
		"lint:fast": "eslint . --cache --cache-location node_modules/.cache/eslint",
		"lint:typography": "./scripts/lint-typography.sh",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:quick": "npm run test:unit -- --run",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:local": "playwright test --config playwright.local.config.ts",
		"convex:codegen": "convex codegen",
		"ci": "npm run check && npm run lint:ci && npm run build"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@internationalized/date": "^3.11.0",
		"@lucide/svelte": "^1.7.0",
		"@playwright/test": "^1.58.1",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.0.18",
		"better-auth": "^1.4.9",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.58.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"runed": "^0.37.1",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"svelte-dnd-action": "^0.9.69",
		"svelte-sonner": "^1.1.0",
		"svelte-toolbelt": "^0.10.6",
		"sveltekit-superforms": "^2.29.1",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1",
		"vitest": "^4.0.18",
		"vitest-browser-svelte": "^2.0.2"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.940.0",
		"@aws-sdk/s3-presigned-post": "^3.1019.0",
		"@aws-sdk/s3-request-presigner": "^3.940.0",
		"@convex-dev/better-auth": "^0.10.10",
		"@fontsource/bevan": "^5.2.7",
		"@fontsource/dm-sans": "^5.2.8",
		"@iconify/svelte": "^5.2.1",
		"@icons-pack/svelte-simple-icons": "6.5.0",
		"@mmailaender/convex-better-auth-svelte": "^0.5.0",
		"convex": "^1.33.1",
		"convex-svelte": "^0.0.12",
		"mapbox-gl": "^3.20.0"
	}
}
