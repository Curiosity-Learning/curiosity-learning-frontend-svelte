# Convex
PUBLIC_CONVEX_URL=""
PUBLIC_CONVEX_SITE_URL=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""

# Email (Convex environment variables)
# These are read in `src/convex/auth.ts` when sending verification/reset emails.
RESEND_API_KEY=""
# Optional: defaults to "Curiosity Learning <onboarding@resend.dev>"
RESEND_FROM=""

# Dev-only: widen trusted origins for LAN testing (do not enable in production)
ALLOW_LAN_TRUSTED_ORIGINS="false"
