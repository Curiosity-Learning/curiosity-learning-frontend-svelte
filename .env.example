# Local app + Convex CLI env (checked by Vite/SvelteKit and `convex dev`)
# Copy this file to `.env.local` and fill in values.

# Deployment used by `npm run dev:backend` / `convex dev`
CONVEX_DEPLOYMENT=""

# Convex endpoints used by the web app
PUBLIC_CONVEX_URL=""
PUBLIC_CONVEX_SITE_URL=""
PUBLIC_MAPBOX_ACCESS_TOKEN=""
PUBLIC_SENTRY_DSN="https://d01f876073a72f8b3d36d41a8372e2c8@o4511563803852800.ingest.de.sentry.io/4511563814207568"
PUBLIC_SENTRY_ENVIRONMENT="development"

# Better Auth values used by SvelteKit auth handler
# For production use 32+ random characters for secret.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5173"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional server-side secure media delivery config for the SvelteKit app.
# Set these together when CloudFront signed URL delivery is ready:
# MEDIA_CDN_BASE_URL="https://assets.example.org"
# MEDIA_CLOUDFRONT_PUBLIC_KEY_ID=""
# MEDIA_CLOUDFRONT_PRIVATE_KEY=""
# Optional:
# MEDIA_CLOUDFRONT_IMAGE_URL_TTL_SECONDS="300"
# MEDIA_CLOUDFRONT_VIDEO_MIN_URL_TTL_SECONDS="7200"

# Optional dev-only flag. Keep false unless you intentionally need LAN wildcard origins.
ALLOW_LAN_TRUSTED_ORIGINS="false"

# Optional local server-side Sentry environment override.
SENTRY_ENVIRONMENT="development"

# Production-only app secrets. Set these in Vercel, not local files:
# - SENTRY_AUTH_TOKEN (source-map uploads during builds)
# - MONITORING_REPORT_SECRET (random shared secret; also set in Convex)
# - RESEND_WEBHOOK_SECRET (from the Resend webhook configuration)

# Convex deployment env only (do not put in local .env files):
# - BETTER_AUTH_SECRET (match local value)
# - BETTER_AUTH_URL (match local value)
# - PUBLIC_CONVEX_SITE_URL
# - RESEND_API_KEY
# - RESEND_FROM
# - MONITORING_REPORT_SECRET (match the Vercel value)
# - EMAIL_LOGO_URL (recommended; absolute HTTPS URL for email header logo)
# - EMAIL_ASSET_BASE_URL (optional fallback for /brand/curiosity-learning-logo.png)
# - MEDIA_S3_REGION
# - MEDIA_S3_BUCKET
# - MEDIA_S3_ACCESS_KEY_ID
# - MEDIA_S3_SECRET_ACCESS_KEY
# - MEDIA_S3_PUBLIC_BASE_URL (recommended for ready asset URLs)
# Optional:
# - MEDIA_S3_ENDPOINT
# - MEDIA_S3_FORCE_PATH_STYLE
# - MEDIA_S3_UPLOAD_URL_TTL_SECONDS
# - MEDIA_S3_ENV_PREFIX
# - MEDIA_S3_OBJECT_PREFIX
# Set them with:
#   npx convex env set BETTER_AUTH_SECRET <same-secret-as-env-local>
#   npx convex env set BETTER_AUTH_URL http://localhost:5173
#   npx convex env set PUBLIC_CONVEX_SITE_URL https://<your-deployment>.convex.site
#   npx convex env set RESEND_API_KEY <key>
#   npx convex env set RESEND_FROM "Curiosity Learning <your-verified-from@domain.com>"
#   npx convex env set EMAIL_LOGO_URL https://<your-app-domain>/brand/curiosity-learning-logo.png
