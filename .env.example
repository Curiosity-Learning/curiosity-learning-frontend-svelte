# Local app + Convex CLI env (checked by Vite/SvelteKit and `convex dev`)
# Copy this file to `.env.local` and fill in values.

# Deployment used by `npm run dev:backend` / `convex dev`
CONVEX_DEPLOYMENT=""

# Convex endpoints used by the web app
PUBLIC_CONVEX_URL=""
PUBLIC_CONVEX_SITE_URL=""

# Better Auth values used by SvelteKit auth handler
# For production use 32+ random characters for secret.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5173"

# Optional server-side secure media delivery config for the SvelteKit app.
# Set these together when CloudFront private media is ready:
# MEDIA_CDN_BASE_URL="https://assets.example.org"
# MEDIA_CLOUDFRONT_PUBLIC_KEY_ID=""
# MEDIA_CLOUDFRONT_PRIVATE_KEY=""
# MEDIA_CLOUDFRONT_COOKIE_DOMAIN=".example.org"
# Optional:
# MEDIA_CLOUDFRONT_COOKIE_TTL_SECONDS="300"

# Optional dev-only flag. Keep false unless you intentionally need LAN wildcard origins.
ALLOW_LAN_TRUSTED_ORIGINS="false"

# Convex deployment env only (do not put in local .env files):
# - RESEND_API_KEY
# - RESEND_FROM
# - MEDIA_S3_REGION
# - MEDIA_S3_BUCKET
# - MEDIA_S3_ACCESS_KEY_ID
# - MEDIA_S3_SECRET_ACCESS_KEY
# - MEDIA_S3_PUBLIC_BASE_URL (recommended for ready asset URLs)
# Optional:
# - MEDIA_S3_ENDPOINT
# - MEDIA_S3_FORCE_PATH_STYLE
# - MEDIA_S3_UPLOAD_URL_TTL_SECONDS
# - MEDIA_S3_ENV_PREFIX
# - MEDIA_S3_OBJECT_PREFIX
# Set them with:
#   npx convex env set RESEND_API_KEY <key>
#   npx convex env set RESEND_FROM "Curiosity Learning <your-verified-from@domain.com>"
