# Copy to .env.e2e (gitignored) for `npm run test:e2e:roles` (CL-816).
# Passwords of the cl-e2e-* test accounts in the shared dev data (ask Ron, or see the
# e2e-testing-setup memory note).
E2E_PASSWORD_LEARNER=
E2E_PASSWORD_GUIDE=
E2E_PASSWORD_PARENT=
E2E_PASSWORD_CHILD=
E2E_PASSWORD_CLUB_LESS=
E2E_PASSWORD_REVIEWER=

# Optional: run against another app, e.g. a Vercel branch preview.
# E2E_BASE_URL=https://<project>-git-<branch>-<team>.vercel.app
# VERCEL_AUTOMATION_BYPASS_SECRET=
